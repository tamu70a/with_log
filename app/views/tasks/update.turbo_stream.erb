<% if params[:edit] %>
  <%= turbo_stream.replace "task_#{@task.id}",
        partial: "tasks/edit",
        locals: { task: @task } %>
<% else %>
  <%= turbo_stream.replace "task_#{@task.id}",
        partial: "tasks/task",
        locals: { task: @task } %>
<% end %>
