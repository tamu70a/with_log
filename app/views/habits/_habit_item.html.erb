<div class="flex items-center gap-3 p-2 bg-white rounded-lg shadow">
  
<%= button_to(
  habit.checked_today? ? "✅" : "□",
  toggle_check_habit_path(habit),
  method: :patch,
  class: "text-lg cursor-pointer"
) %>

  <div class="flex-1">
    <div class="font-medium"><%= habit.title %></div>
    <div class="text-sm text-gray-500">
      <%= habit.current_count %> / <%= habit.total_days %>
    </div>
  </div>

</div>