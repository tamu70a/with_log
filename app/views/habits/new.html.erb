<h1 class="text-xl font-bold mb-6">習慣新規登録</h1>
<% if @habit.errors.any? %>
  <div class="alert alert-error shadow-sm mb-4 py-2 flex flex-col items-start gap-1">
    <% @habit.errors.full_messages.each do |message| %>
      <div class="text-sm font-bold flex items-center gap-2">
        <span>・<%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>
<%= form_with model: @habit, class: "space-y-4" do |f| %>

  <div>
    <%= f.label :title, "習慣名", class: "label" %>
    <%= f.text_field :title,
          class: "input input-bordered w-full",
          placeholder: "例：毎日ストレッチ" %>
  </div>

  <div class="flex gap-4">
    <div class="flex-1">
      <%= f.label :start_date, "開始日", class: "label" %>
      <%= f.date_field :start_date, class: "input input-bordered w-full" %>
    </div>

    <div class="flex-1">
      <%= f.label :end_date, "終了日", class: "label" %>
      <%= f.date_field :end_date, class: "input input-bordered w-full" %>
    </div>
  </div>

  <div class="pt-4">
    <%= f.submit "登録",
          class: "btn btn-primary w-full" %>
  </div>

<% end %>
