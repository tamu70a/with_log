<!DOCTYPE html>
<html lang="ja" data-theme="pastel">
  <head>
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-100 min-h-screen flex flex-col">
    <body class="bg-gray-100 min-h-screen flex flex-col">

  <% if notice.present? %>
    <div class="toast toast-top toast-center z-50 mt-20">
      <div class="alert alert-success shadow-lg">
        <span><%= notice %></span>
      </div>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="toast toast-top toast-center z-50 mt-20">
      <div class="alert alert-error shadow-lg">
        <span><%= alert %></span>
      </div>
    </div>
  <% end %>

    <main class="<%= devise_controller? && controller_name == 'sessions' && action_name == 'new' ?
      'max-w-md mx-auto mt-16 p-6 bg-white shadow rounded-lg' : 
      'container mx-auto mt-28 px-5 flex-1 pb-[calc(7rem+env(safe-area-inset-bottom))]' %>">
      <%= yield %>
    </main>

    <turbo-frame id="modal"></turbo-frame>

    <% if user_signed_in? %>
      <%= render "devise/shared/footer" %>
    <% end %>
  </body>
  
</html>
