<!DOCTYPE html>
<html lang="ja" data-theme="pastel">
  <head>
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-100 min-h-screen flex flex-col">

  <% if notice.present? %>
  <div class="toast toast-top toast-center z-50 mt-20" onclick="this.remove();">
    <div class="alert alert-success shadow-lg cursor-pointer hover:scale-105 transition-all duration-200 group">
      <div class="flex items-center justify-between w-full gap-2">
        <span><%= notice %></span>
        <span class="text-xs opacity-50 group-hover:opacity-100 font-bold">✕</span>
      </div>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="toast toast-top toast-center z-50 mt-20" onclick="this.remove();">
    <div class="alert alert-error shadow-lg cursor-pointer hover:scale-105 transition-all duration-200 group">
      <div class="flex items-center justify-between w-full gap-2">
        <span><%= alert %></span>
        <span class="text-xs opacity-50 group-hover:opacity-100 font-bold">✕</span>
      </div>
    </div>
  </div>
<% end %>

    <main class="<%= devise_controller? && controller_name == 'sessions' && action_name == 'new' ?
      'max-w-md mx-auto mt-16 p-6 bg-white shadow rounded-lg' : 
      'container mx-auto mt-16 px-4 flex-1 pb-24' %>">
      <%= yield %>
    </main>

    <turbo-frame id="modal"></turbo-frame>

    <% if user_signed_in? %>
      <%= render "devise/shared/footer" %>
    <% end %>
  </body>
  
</html>
