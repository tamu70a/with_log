<div class="max-w-md mx-auto space-y-6 px-4 pb-32">

  <!-- ヘッダー部（日時 / 天気 / 洗濯） -->
<div class="grid grid-cols-2 gap-4">

  <!-- 日時 -->
  <div class="bg-base-200 rounded-lg p-4 text-center">
    <p class="text-sm text-gray-500">
      <%= l(Time.current, format: :short) %>
    </p>
  </div>

  <!-- 天気 -->
  <div class="bg-base-200 rounded-lg p-4">
    <% if @weather.present? %>
      <div class="flex items-center gap-4">
        <img
          src="https://openweathermap.org/img/wn/<%= @weather[:icon] %>@2x.png"
          alt="天気アイコン"
          class="w-14 h-14"
        />
        <div class="text-sm">
          <p><%= @weather[:description] %></p>
          <p class="font-semibold"><%= @weather[:temp] %> ℃</p>
        </div>
      </div>
    <% else %>
      <p class="text-gray-400 text-sm text-center">
        天気情報を取得できませんでした
      </p>
    <% end %>
  </div>

  <!-- 洗濯・湿度 -->
  <div class="col-span-2 space-y-2">
    <div class="flex items-center justify-between bg-white rounded-lg p-2 shadow">
      <%= image_tag "weather/sunny.png", class: "w-6 h-6" %>
      <div class="text-right text-sm">
        <div class="text-pink-500">14℃ <span class="text-xs text-gray-500">+3</span></div>
        <div class="text-blue-500">1℃ <span class="text-xs text-gray-500">+1</span></div>
      </div>
    </div>

    <div class="flex items-center justify-between bg-white rounded-lg p-2 shadow">
      <%= image_tag "laundry/basic.png", class: "w-6 h-6" %>
      <div class="text-sm font-medium">
        <%= @weather&.dig(:humidity) || "--" %>%
      </div>
    </div>
  </div>

</div>

  <!-- バディからのメッセージ -->
  <div id="buddy_message_area"> <div class="flex items-start gap-3 mb-2">
    <div class="avatar">
      <div class="w-14 h-14 rounded-full ring ring-pink-200 ring-offset-base-100 ring-offset-2 bg-pink-50 flex items-center justify-center shadow-sm overflow-hidden">
        <%= image_tag "buddy/cat_tea.png", class: "w-full h-full object-cover" %>
      </div>
    </div>

    <div class="relative bg-white p-4 rounded-2xl rounded-tl-none shadow-sm border border-pink-100 flex-1">
      <div class="absolute -left-2 top-0 w-0 h-0 border-t-[12px] border-t-white border-l-[12px] border-l-transparent"></div>
      
      <div class="space-y-1">
        <p class="text-sm text-gray-700 leading-relaxed">
          <%= @message %>
        </p>
      </div>
    </div>
  </div>
</div>

<!-- TODOリスト -->
<div class="bg-base-100 rounded-lg p-4 shadow space-y-2">
  <h3 class="text-md font-bold">TODO</h3>

  <div id='tasks'>
    <%= render @tasks %>
  </div>

  <% if @tasks.empty? %>
    <p class="text-sm text-gray-400 text-center">
      タスクはまだありません
    </p>
  <% end %>

  <!-- ボタン -->
  <div id="task_form">
    <%= button_to "タスク追加", tasks_path,
        method: :post,
        form: { data: { turbo: true } },
        class: "btn btn-primary w-full" %>
  </div>

<!-- 習慣リスト -->
<div class="bg-base-200 rounded-lg p-4 shadow">
  <h3 class="text-md font-bold">習慣</h3>

  <% if @habits.any? %>
    <div class="space-y-2 mt-4">
      <% @habits.each do |habit| %>
        <%# ★変更点：turbo_frame_tag をやめて、普通の div に ID を振る %>
        <div id="habit_<%= habit.id %>">
          <%= render "habits/habit_item", habit: habit %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-center text-gray-400 mt-4">まだ習慣がありません</p>
  <% end %>
</div>


  <!-- メモ -->
<div
  data-controller="inline-memo"
  class="bg-base-100 rounded-lg p-4 shadow space-y-2"
>
  <h3 class="text-md font-bold">ちょこっとメモ</h3>

  <!-- 表示用 -->
  <p
    data-inline-memo-target="display"
    data-action="click->inline-memo#edit"
    class="textarea textarea-bordered w-full min-h-[6rem]
           text-sm text-gray-600 cursor-text whitespace-pre-wrap"
>
    <%= @home_memo.content.presence || "タップしてメモを入力" %>
  </p>

  <!-- 編集用 -->
  <textarea
    data-inline-memo-target="input"
    data-action="blur->inline-memo#save"
    class="textarea textarea-bordered w-full hidden"
    rows="4"
  ><%= @home_memo.content %></textarea>
</div>


 <!-- 体重目標 -->
<div class="bg-base-100 rounded-lg p-4 shadow">
  <h3 class="text-md font-bold">body</h3>

  <div class="flex justify-between items-center mt-2 space-x-2">

    <!-- 残り日数 -->
    <div class="input input-bordered flex items-center gap-2 w-1/2">
      目標まで残り
      <span class="grow text-right font-semibold">
        <% if @latest_goal.present? %>
          <%= @latest_goal.days_remaining %>
        <% else %>
          --
        <% end %>
      </span>
      <span>日</span>
    </div>

    <!-- 残り体重 -->
    <div class="input input-bordered flex items-center gap-2 w-1/2">
      <span class="grow text-right font-semibold">
        <% if @latest_goal.present? && @latest_body_record.present? %>
          <%= @latest_goal.remaining_weight(@latest_body_record.weight) %>
        <% else %>
          --
        <% end %>
      </span>
      <span>kg</span>
    </div>

  </div>

  <!-- ボタン -->
  <div class="mt-2 text-right">
    <%= link_to body_records_path,
        class: "btn btn-circle bg-pink-300 text-white shadow-md" do %>
      ✏️
    <% end %>
  </div>
</div>
</div>
