<div class="max-w-md md:max-w-2xl mx-auto px-3">

  <!-- ヘッダー -->
  <div class="flex items-center justify-center mb-4 relative">
    <h1 class="text-lg md:text-xl font-bold text-gray-700 tracking-wide">
      成長のきろく
    </h1>

    <div class="absolute right-0 inset-y-0 flex items-center pr-2">
<!-- 子供選択ドロップダウン -->
<div class="dropdown dropdown-end">
  <!-- ドロップダウントリガー -->
  <div tabindex="0"
       class="flex items-center gap-2 cursor-pointer bg-primary/50 px-3 py-1 rounded-full border border-gray-200 shadow-sm hover:bg-gray-100 transition">
    <%# 現在選択中の子供の名前 %>
    <span class="text-xs font-semibold text-gray-700 truncate max-w-[100px] whitespace-nowrap">
      <%= @child.name %>
    </span>
    <!-- 下向き矢印 -->
    <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

  <!-- ドロップダウンメニュー -->
  <ul tabindex="0"
      class="dropdown-content z-[50] menu p-2 shadow-xl bg-base-100 text-primary-content rounded-2xl w-48 mt-2 border border-primary">
    <li class="menu-title text-xs px-2 py-1 text-gray-400">お子さまを選択</li>
    <% current_user.children.each do |child| %>
      <li>
        <%= link_to child_growth_records_path(child),
              class: "block px-3 py-2 rounded-xl hover:bg-primary hover:text-white transition" do %>
          <span class="font-medium text-gray-700"><%= child.name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
    </div>
  </div>

  <!-- 月齢タブ -->
  <div class="flex overflow-x-auto whitespace-nowrap bg-white border-b border-base-200 no-scrollbar mb-4">
    <% (0..@child.current_month_age).reverse_each do |age| %>
      <% label = age < 12 ? "#{age}ヶ月" : "#{age / 12}歳#{age % 12}ヶ月" %>
      <%= link_to child_growth_records_path(@child, month_age: age),
          class: "inline-block px-4 py-1 transition-all #{ @month_age == age ? 'bg-primary text-primary-content font-bold rounded-xl' : 'text-gray-400 hover:bg-base-100 rounded-xl' } mr-2" do %>
        <div class="text-center">
          <div class="text-sm"><%= label %></div>
          <div class="text-[9px] font-normal opacity-80"><%= @child.date_range_for(age) %></div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- 記録カード -->
  <div class="bg-white rounded-[2rem] p-4 shadow-md border border-base-200 mb-6">

    <%= form_with model: @growth_record, url: child_growth_records_path(@child), local: true do |f| %>
      <%= f.hidden_field :month_age, value: @month_age %>

      <div class="space-y-3">

        <!-- 身長・体重 -->
        <div class="grid grid-cols-2 gap-4">
          <div class="form-control">
            <%= f.label :body_height, "身長 (cm)", class: "label-text font-bold text-gray-600" %>
            <%= f.number_field :body_height,
                  step: 0.1,
                  class: "input input-bordered border-base-300 bg-white rounded-xl focus:border-primary text-lg w-full" %>
          </div>

          <div class="form-control">
            <%= f.label :body_weight, "体重 (kg)", class: "label-text font-bold text-gray-600" %>
            <%= f.number_field :body_weight,
                  step: 0.1,
                  class: "input input-bordered border-base-300 bg-white rounded-xl focus:border-primary text-lg w-full" %>
          </div>
        </div>

        <!-- メモ -->
        <div class="form-control">
          <%= f.label :content, "成長のメモ", class: "label-text font-bold text-gray-600" %>
          <% default_text = "【食事】\n\n【好きな遊び】\n\n【言葉】\n\n【睡眠】\n\n【その他】" %>
          <%= f.text_area :content,
                value: f.object.content.presence || default_text,
                style: "height: 240px;", 
                class: "textarea textarea-bordered border-base-300 bg-white w-full rounded-2xl resize-none focus:border-primary leading-relaxed text-gray-700",
                placeholder: "日常の記録をここに。" %>
        </div>

      </div>

      <!-- ボタン -->
      <div class="flex justify-center mt-4">
        <%= f.submit "この内容で記録する",
              class: "btn btn-primary btn-lg w-full max-w-md shadow-lg font-bold text-lg rounded-2xl" %>
      </div>

    <% end %>
  </div>

</div>