<div class="max-w-md mx-auto min-h-screen bg-base-100 pb-24">
  
  <%# --- ヘッダー --- %>
  <div class="p-6 text-center bg-white border-b border-base-200 relative">
    <h1 class="text-lg font-bold text-gray-700 tracking-wider">成長のきろく</h1>

    <%# 右上：お子さま切り替え %>
    <div class="absolute right-4 top-3">
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="cursor-pointer group">
          <div class="flex flex-col items-center">
            <div class="text-[10px] font-bold text-gray-400 mb-1">
              <%= @child.name %>
            </div>
            <div class="avatar">
              <div class="w-10 rounded-full ring ring-primary ring-offset-2 bg-white shadow-sm border border-base-300">
                <span class="flex items-center justify-center h-full text-xl">👶</span>
              </div>
            </div>
          </div>
        </label>
        <ul tabindex="0" class="dropdown-content z-[50] menu p-2 shadow-2xl bg-base-100 rounded-2xl w-52 mt-4 border border-base-200">
          <li class="menu-title text-gray-400 text-[10px] px-4">お子さまを選択</li>
          <% current_user.children.each do |child| %>
            <li>
              <%= link_to child_growth_records_path(child), class: "rounded-xl py-3 #{'active' if child == @child}" do %>
                <span class="font-bold"><%= child.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <%# --- 月齢タブ（選択中をはっきり色付け） --- %>
  <div class="flex overflow-x-auto whitespace-nowrap bg-white border-b border-base-200 no-scrollbar">
    <% (0..@child.current_month_age).reverse_each do |age| %>
      <% label = age < 12 ? "#{age}ヶ月" : "#{age / 12}歳#{age % 12}ヶ月" %>
      <%= link_to child_growth_records_path(@child, month_age: age), 
          class: "inline-block px-6 py-4 transition-all #{ @month_age == age ? 'bg-primary text-primary-content font-bold' : 'text-gray-400 hover:bg-base-100' }" do %>
        <div class="text-center">
          <div class="text-sm"><%= label %></div>
          <div class="text-[9px] font-normal opacity-80"><%= @child.date_range_for(age) %></div>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# --- 選択中インジケーター --- %>
  <div class="px-6 py-6 flex justify-between items-end">
    <div>
      <span class="text-xs font-bold text-gray-400 block mb-1 font-mono uppercase tracking-tighter">Selected Month</span>
      <h2 class="text-3xl font-black text-gray-800">
        <%= @month_age < 12 ? "#{@month_age}ヶ月" : "#{@month_age / 12}歳#{@month_age % 12}ヶ月" %>
      </h2>
    </div>
    <div class="badge badge-primary badge-outline font-bold py-3">
      <%= @child.date_range_for(@month_age) %>
    </div>
  </div>

  <%# --- 記録エリア --- %>
  <div class="px-6">
    <div class="bg-white rounded-[2rem] p-8 shadow-md border border-base-200">
      <%= form_with model: @growth_record, url: child_growth_records_path(@child), local: true do |f| %>
        <%= f.hidden_field :month_age, value: @month_age %>
        
        <div class="space-y-6">
          <div class="grid grid-cols-2 gap-4">
            <div class="form-control">
              <label class="label"><span class="label-text font-bold text-gray-600">身長 (cm)</span></label>
              <%# 枠線を復活させ、背景を少し変えて「入力できる感」を出しました %>
              <%= f.number_field :body_height, step: 0.1, class: "input input-bordered border-base-300 bg-white rounded-xl focus:border-primary text-lg w-full" %>
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text font-bold text-gray-600">体重 (kg)</span></label>
              <%= f.number_field :body_weight, step: 0.1, class: "input input-bordered border-base-300 bg-white rounded-xl focus:border-primary text-lg w-full" %>
            </div>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-bold text-gray-600">成長のメモ</span>
            </label>
            <% default_text = "【食事】\n\n【好きな遊び】\n\n【言葉】\n\n【睡眠】\n\n【その他】" %>
            <%# textareaにも枠線をしっかり追加 %>
            <%= f.text_area :content, 
                  value: f.object.content.presence || default_text,
                  class: "textarea textarea-bordered border-base-300 bg-white w-full h-80 rounded-2xl resize-none focus:border-primary leading-relaxed text-gray-700", 
                  placeholder: "日常の記録をここに。" %>
          </div>
        </div>

        <div class="mt-8">
          <%= f.submit "この内容で記録する", class: "btn btn-primary btn-block rounded-2xl shadow-md text-white border-none h-14 font-bold text-lg" %>
        </div>
      <% end %>
    </div>
  </div>
</div>