<div class="max-w-md md:max-w-2xl mx-auto space-y-10 px-4 py-12 pb-32">

  <div class="text-center space-y-3 py-4">
    <div class="flex justify-center items-center">
      <%= image_tag "logo_withlog.png", class: "h-20 md:h-24 w-auto object-contain", alt: "WithLog+" %>
    </div>
    <h2 class="text-[12px] md:text-sm font-bold text-gray-400 tracking-[0.2em] leading-relaxed">
      ひとりじゃない、毎日のログ。
    </h2>
  </div>

  <div class="bg-base-100 rounded-[2.5rem] p-8 shadow-2xl border-2 border-purple-50 text-center space-y-6">
    <div class="space-y-4">
      <%= link_to "新しくはじめる", new_user_registration_path, 
          class: "btn bg-purple-500 hover:bg-purple-600 border-none btn-lg w-full h-16 rounded-full text-white shadow-xl text-xl font-bold transition-all active:scale-95" %>
      
      <%= link_to "ログインはこちら", new_user_session_path, 
          class: "text-base font-bold text-gray-600 hover:bg-purple-50 transition-colors block py-3 bg-gray-50 rounded-2xl border border-gray-100 shadow-sm" %>
    </div>
  </div>

  <div class="flex items-center gap-6 px-4 md:px-8 pt-2"> 
    <div class="flex-shrink-0 relative">
      <div class="absolute inset-0 bg-gradient-to-br from-pink-200/40 to-purple-200/40 blur-2xl rounded-full scale-125"></div>
      <div class="relative w-26 h-26 md:w-30 md:h-30 rounded-full bg-white shadow-sm overflow-hidden p-1">
        <%= image_tag "buddy/cat_top3.png", class: "w-full h-full object-cover rounded-full" %>
      </div>
    </div>

    <div class="flex-1 min-w-0 border-l-2 border-pink-100 pl-6 py-1">
      <p class="text-[10px] font-bold text-pink-300 uppercase tracking-widest mb-1">Our Buddy</p>
      <p class="text-sm md:text-base text-gray-500 leading-relaxed font-medium">
        育児や仕事で忙しい毎日を送るあなたへ。<br>
        バディが朝・昼・晩の1日3回、<br>
        そっと寄り添うメッセージをお届けします。
      </p>
    </div>
  </div>

  <div class="space-y-4 pt-2 text-gray-700">
    
    <%# TODO %>
    <div class="bg-base-100 rounded-[2rem] p-5 shadow-sm border border-base-200 flex items-center gap-5">
      <div class="w-16 h-16 rounded-full bg-purple-50 flex items-center justify-center p-3 shadow-inner flex-shrink-0">
        <%= image_tag "todo.png", class: "w-full h-full object-contain" %>
      </div>
      <div class="flex-1">
        <h3 class="text-base font-bold text-gray-800">✅ TODO・習慣・メモ</h3>
        <p class="text-base text-gray-500 mt-0.5">忙しい日常のタスクや、大切なひらめきを一箇所に。</p>
      </div>
    </div>

    <%# 成長記録 %>
    <div class="bg-base-100 rounded-[2rem] p-5 shadow-sm border border-base-200 flex items-center gap-5">
      <div class="w-16 h-16 rounded-full bg-pink-50 flex items-center justify-center p-3 shadow-inner flex-shrink-0">
        <%= image_tag "growth_record.png", class: "w-full h-full object-contain" %>
      </div>
      <div class="flex-1">
        <h3 class="text-base font-bold text-gray-800">🍼 成長記録</h3>
        <p class="text-base text-gray-500 mt-0.5">食事や睡眠、ちいさな『はじめて』。月齢ごとに大切な成長を残せます</p>
      </div>
    </div>

    <%# 体重記録 %>
    <div class="bg-base-100 rounded-[2rem] p-5 shadow-sm border border-base-200 flex items-center gap-5">
      <div class="w-16 h-16 rounded-full bg-yellow-50 flex items-center justify-center p-3 shadow-inner flex-shrink-0">
        <%= image_tag "weight.png", class: "w-full h-full object-contain" %>
      </div>
      <div class="flex-1">
        <h3 class="text-base font-bold text-gray-800">⚖️ 体重管理</h3>
        <p class="text-base text-gray-500 mt-0.5">目標体重を設定して、無理なく健康管理を。</p>
      </div>
    </div>
  </div>

</div>