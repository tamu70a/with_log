<% if @current_goal && @latest_weight %>
  <div class="max-w-md mx-auto px-4 mt-6">
    <div class="bg-primary text-primary-content rounded-xl p-4 shadow">

      <div class="flex justify-between items-center">
        <div>
          <p class="text-sm opacity-80">目標体重</p>
          <p class="text-2xl font-bold">
            <%= @current_goal.target_weight %> kg
          </p>
          <p class="text-sm">
            期限: <%= @current_goal.target_date.strftime("%Y/%m/%d") %>
          </p>
        </div>

        <div class="text-right">
          <p class="text-sm opacity-80">あと</p>
          <p class="text-xl font-semibold">
            <%= @current_goal.remaining_weight(@latest_weight.weight) %> kg
          </p>
          <p class="text-sm">
            <%= @current_goal.days_remaining %> 日
          </p>
        </div>
      </div>

      <div class="mt-3">
        <%= link_to "目標を変更",
              edit_weight_goal_path(@current_goal),
              class: "btn btn-sm btn-outline btn-secondary w-full" %>
      </div>

    </div>
  </div>
<% else %>
  <div class="max-w-md mx-auto px-4 mt-6">
    <div class="bg-base-200 rounded-xl p-4 shadow text-center">
      <p class="mb-2">目標がまだ設定されていません</p>
    </div>
  </div>
<% end %>

<div class="max-w-md mx-auto px-4 mt-6">
  <div class="bg-base-100 rounded-xl p-4 shadow">

    <h2 class="text-lg font-bold mb-2">体重・体脂肪グラフ</h2>

    <canvas id="weightChart"></canvas>

    <!-- Rails → JS にデータ渡す -->
    <script id="body-records-data" type="application/json">
      {
        "labels": <%= raw @body_records.pluck(:measured_on).map { |d| d.strftime("%m/%d") }.to_json %>,
        "weights": <%= raw @body_records.pluck(:weight).to_json %>,
        "body_fats": <%= raw @body_records.pluck(:body_fat).to_json %>
      }
    </script>

  </div>
</div>


<!-- 入力フォーム -->
<div class="fixed bottom-20 left-0 right-0 px-4">
  <div class="bg-base-200 rounded-xl p-4 shadow-lg">

    <%= form_with model: @body_record, url: body_records_path, local: true do |f| %>

      <div class="flex gap-4 mb-4">
        
        <div class="flex-1">
          <label class="text-sm">体重</label>
          <div class="flex items-center gap-2">
            <%= f.number_field :weight,
                  step: 0.1,
                  class: "input input-bordered w-full" %>
            <span>kg</span>
          </div>
        </div>

        <div class="flex-1">
          <label class="text-sm">体脂肪</label>
          <div class="flex items-center gap-2">
            <%= f.number_field :body_fat,
                  step: 0.1,
                  class: "input input-bordered w-full" %>
            <span>%</span>
          </div>
        </div>

      </div>

      <%= f.submit "入力",
            class: "btn btn-primary w-full" %>

    <% end %>
  </div>
</div>
