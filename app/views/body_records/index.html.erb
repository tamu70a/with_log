<% flash.each do |key, message| %>
  <div class="max-w-md mx-auto px-4 mt-4 p-3 rounded shadow
              <%= key == 'notice' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
    <%= message %>
  </div>
<% end %>

<% if @current_goal %>
  <div class="max-w-md mx-auto px-4 mt-6">
    <div class="bg-primary text-primary-content rounded-xl p-4 shadow">
      <div class="flex justify-between items-center">
        <div>
          <p class="text-sm opacity-80">目標体重</p>
          <p class="text-2xl font-bold"><%= @current_goal.target_weight %> kg</p>
          <p class="text-sm">期限: <%= @current_goal.target_date.strftime("%Y/%m/%d") %></p>
        </div>

        <div class="text-right">
          <% if @latest_weight %>
            <p class="text-sm opacity-80">あと</p>
            <p class="text-xl font-semibold"><%= @current_goal.remaining_weight(@latest_weight.weight) %> kg</p>
          <% else %>
            <p class="text-xl font-semibold">-- kg</p>
          <% end %>
          <p class="text-sm"><%= @current_goal.days_remaining %> 日</p>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="max-w-md mx-auto px-4 mt-6">
    <div class="bg-base-200 rounded-xl p-4 shadow text-center">
      <p class="mb-2">目標がまだ設定されていません</p>
      <%= link_to "目標を設定する", settings_weight_goals_path, class: "text-primary text-sm underline" %>
    </div>
  </div>
<% end %>

<div class="max-w-md mx-auto px-4 mt-6">
  <div class="bg-base-100 rounded-xl p-4 shadow">
    <h2 class="text-lg font-bold mb-2">体重・体脂肪グラフ</h2>
    <canvas id="weightChart"></canvas>

    <script id="body-records-data" type="application/json">
      {
        "labels": <%= raw (@valid_records_for_chart || []).pluck(:measured_on).map { |d| d.strftime("%m/%d") }.to_json %>,
        "weights": <%= raw (@valid_records_for_chart || []).pluck(:weight).to_json %>,
        "body_fats": <%= raw (@valid_records_for_chart || []).pluck(:body_fat).to_json %>
      }
    </script>
  </div>
</div>

<div class="max-w-md mx-auto px-4 mt-6 mb-12">
  <div class="bg-base-200 rounded-xl p-4 shadow">
    <%= form_with model: @body_record, url: body_records_path, local: true do |f| %>

      <div class="flex gap-4 mb-4">
        <%# 体重入力 %>
        <div class="flex-1">
          <label class="text-sm font-bold">体重</label>
          <div class="flex items-center gap-2">
            <%= f.number_field :weight, 
                  step: 0.1, 
                  min: 0.1, 
                  required: true, 
                  class: "input input-bordered w-full",
                  placeholder: "0.0" %>
            <span class="text-sm">kg</span>
          </div>
        </div>

        <%# 体脂肪入力 %>
        <div class="flex-1">
          <label class="text-sm font-bold">体脂肪</label>
          <div class="flex items-center gap-2">
            <%= f.number_field :body_fat, 
                  step: 0.1, 
                  class: "input input-bordered w-full",
                  placeholder: "任意" %>
            <span class="text-sm">%</span>
          </div>
        </div>
      </div>

      <%= f.submit "入力を完了する", class: "btn btn-primary w-full shadow-md" %>

    <% end %>
  </div>
</div>