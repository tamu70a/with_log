<div class="max-w-md mx-auto px-4 mt-6">
  <div class="bg-base-100 rounded-xl p-4 shadow">

    <h2 class="text-lg font-bold mb-2">体重・体脂肪グラフ</h2>

    <canvas id="weightChart"></canvas>

    <!-- Rails → JS にデータ渡す -->
    <script id="body-records-data" type="application/json">
      {
        "labels": <%= raw @body_records.pluck(:measured_on).map { |d| d.strftime("%m/%d") }.to_json %>,
        "weights": <%= raw @body_records.pluck(:weight).to_json %>,
        "body_fats": <%= raw @body_records.pluck(:body_fat).to_json %>
      }
    </script>

  </div>
</div>


<!-- 入力フォーム -->
<div class="fixed bottom-20 left-0 right-0 px-4">
  <div class="bg-base-200 rounded-xl p-4 shadow-lg">

    <%= form_with model: @body_record, url: body_records_path, local: true do |f| %>

      <div class="flex gap-4 mb-4">
        
        <div class="flex-1">
          <label class="text-sm">体重</label>
          <div class="flex items-center gap-2">
            <%= f.number_field :weight,
                  step: 0.1,
                  class: "input input-bordered w-full" %>
            <span>kg</span>
          </div>
        </div>

        <div class="flex-1">
          <label class="text-sm">体脂肪</label>
          <div class="flex items-center gap-2">
            <%= f.number_field :body_fat,
                  step: 0.1,
                  class: "input input-bordered w-full" %>
            <span>%</span>
          </div>
        </div>

      </div>

      <%= f.submit "入力",
            class: "btn btn-primary w-full" %>

    <% end %>
  </div>
</div>
