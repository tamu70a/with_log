<div class="max-w-md mx-auto px-4 pb-32">

  <h1 class="text-xl font-bold text-center my-6">
    メモ編集
  </h1>

  <%= form_with model: @memo, class: "space-y-5" do |f| %>

    <% if @memo.errors.any? %>
      <div class="bg-red-100 border border-red-300 text-red-700 rounded-xl p-4 text-sm">
        <ul class="list-disc list-inside">
          <% @memo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white rounded-2xl p-4 shadow border border-base-200">

      <%= f.text_area :content,
            rows: 12,
            class: "w-full textarea textarea-bordered resize-none text-sm leading-relaxed" %>

    </div>
<div class="bg-white rounded-2xl p-4 shadow border border-base-200">

  <%= f.label :memo_date, "記録日", class: "text-sm font-bold text-gray-500" %>

  <%= f.date_field :memo_date,
        class: "input input-bordered w-full mt-2" %>

</div>
    <div class="flex gap-3 pt-4">

      <%= link_to "キャンセル",
          memo_path(@memo),
          class: "btn btn-outline w-1/2" %>

      <%= f.submit "更新",
          class: "btn btn-primary w-1/2 font-bold" %>

    </div>

  <% end %>

</div>