<div class="max-w-md md:max-w-2xl mx-auto px-3 pb-32">
  <h1 class="text-xl font-bold text-center my-6">メモ一覧</h1>

  <% if @memos.any? %>
    <div class="space-y-4">
      <% @memos.each do |memo| %>
        <div class="bg-white rounded-[2rem] px-4 py-3 shadow hover:shadow-md transition border border-base-200">

  <!-- 日付 -->
  <div class="flex justify-between items-center mb-2 px-2">
    <div class="px-3 py-1 text-xs font-bold rounded-full bg-gray-100 text-gray-500">
      <%= l(memo.memo_date, format: "%Y/%m/%d") %>
    </div>
  </div>

  <!-- メモ本文 -->
  <div class="text-sm text-gray-700 leading-relaxed line-clamp-2 px-1 mb-3">
    <%= memo.content %>
  </div>

  <!-- ボタン -->
  <div class="flex gap-2 justify-end">

    <%= link_to edit_memo_path(memo),
        class: "btn btn-sm btn-primary rounded-lg px-4" do %>
      編集
    <% end %>

    <%= link_to memo_path(memo),
        data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
        class: "btn btn-sm btn-outline btn-error rounded-lg px-4" do %>
      削除
    <% end %>

  </div>

</div>

          
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-gray-400 text-sm">
      まだメモが登録されていません
    </div>
  <% end %>

  <%# 新規登録ボタン %>
  <div class="fixed bottom-20 left-0 right-0 px-4 flex justify-center">
    <%= link_to "メモを新規作成", new_memo_path,
        class: "btn btn-primary btn-lg w-full max-w-md shadow-lg font-bold" %>
  </div>
</div>