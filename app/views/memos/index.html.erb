<div class="max-w-md mx-auto px-4 pb-24">
  <h1 class="text-xl font-bold text-center my-6">メモ一覧</h1>

  <div class="space-y-4">
    <% @memos.each do |memo| %>
      <div class="bg-base-100 rounded-lg p-4 shadow border border-base-200">
        
        <div class="flex justify-between items-start mb-3">
          
          <!-- 日付 -->
          <div class="px-3 py-1 text-xs rounded-full bg-base-200 text-base-content">
            <%= memo.memo_date.strftime("%Y/%m/%d") %>
          </div>

          <!-- 編集ボタン -->
          <%= link_to edit_memo_path(memo),
              class: "btn btn-xs bg-base-200 hover:bg-base-300 text-base-content border-none" do %>
            編集
          <% end %>

        </div>

        <!-- メモ本文 -->
        <div class="text-sm text-base-content leading-relaxed whitespace-pre-wrap">
          <%= memo.content %>
        </div>

      </div>
    <% end %>
  </div>
</div>

<!-- 右下の新規ボタン -->
<div class="fixed bottom-20 right-6 z-50">
  <%= link_to new_memo_path,
      class: "btn btn-circle bg-base-200 hover:bg-base-300 text-base-content shadow-xl border-none w-16 h-16 flex items-center justify-center" do %>
    <svg xmlns="http://www.w3.org/2000/svg"
         class="h-8 w-8"
         fill="none"
         viewBox="0 0 24 24"
         stroke="currentColor">
      <path stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 4v16m8-8H4" />
    </svg>
  <% end %>
</div>
