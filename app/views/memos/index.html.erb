<div class="max-w-md mx-auto px-3 pb-32">
  <h1 class="text-xl font-bold text-center my-6">メモ一覧</h1>

  <% if @memos.any? %>
    <div class="space-y-4">
      <% @memos.each do |memo| %>
        <div class="bg-white rounded-[2rem] px-4 py-3 shadow-sm border border-base-200">
          
          <%# --- 日付とボタン --- %>
          <div class="flex justify-between items-center mb-2 px-2">
            <div class="px-3 py-1 text-xs font-bold rounded-full bg-gray-100 text-gray-500">
              <%= memo.memo_date.strftime("%Y/%m/%d") %>
            </div>

            <div class="flex gap-2">
              <%# 編集ボタン %>
              <%= link_to edit_memo_path(memo), class: "btn btn-xs btn-primary h-8 px-3 rounded-lg border-none" do %>
                編集
              <% end %>

              <%# 削除ボタン %>
              <%= link_to memo_path(memo),
                    data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                    class: "btn btn-xs btn-outline btn-error h-8 px-2 rounded-lg" do %>
                削除
              <% end %>
            </div>
          </div>

          <%# --- メモ本文 --- %>
          <div class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap px-1"><%= memo.content %></div>
          
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-gray-400 text-sm">
      まだメモが登録されていません
    </div>
  <% end %>

  <%# 新規登録ボタン %>
  <div class="fixed bottom-20 left-0 right-0 px-4 z-20">
    <%= link_to "メモを新規作成", new_memo_path,
        class: "btn btn-primary btn-lg w-full shadow-lg font-bold" %>
  </div>
</div>