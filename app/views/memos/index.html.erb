<div class="max-w-md mx-auto px-4 pb-32">
  <h1 class="text-xl font-bold text-center my-6">メモ一覧</h1>

  <% if @memos.any? %>
    <div class="space-y-4">
      <% @memos.each do |memo| %>
        <div class="bg-base-100 rounded-lg p-4 shadow border border-base-200">
          <div class="flex justify-between items-start mb-3">
            <div class="px-3 py-1 text-xs rounded-full bg-base-200 text-base-content">
              <%= memo.memo_date.strftime("%Y/%m/%d") %>
            </div>

            <div class="flex gap-2">
              <%= link_to "編集", edit_memo_path(memo),
                  class: "btn btn-xs bg-base-200 hover:bg-base-300 text-base-content border-none" %>

              <%= link_to "削除", memo_path(memo),
                  data: { turbo_method: :delete, turbo_confirm: "このメモを削除しますか？" },
                  class: "btn btn-xs bg-base-200 hover:bg-base-300 text-error border-none" %>
            </div>
          </div>

          <div class="text-sm text-base-content leading-relaxed whitespace-pre-wrap">
            <%= memo.content %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 text-gray-400 text-sm">
      まだメモが登録されていません
    </div>
  <% end %>

  <%# 画面下部に固定された新規作成ボタン %>
  <div class="fixed bottom-24 left-0 right-0 px-4">
    <%= link_to "メモを新規作成", new_memo_path,
        class: "btn btn-primary btn-lg w-full shadow-lg font-bold" %>
  </div>
</div>