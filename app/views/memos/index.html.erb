<div class="max-w-md md:max-w-2xl mx-auto px-4 pb-32">

  <h1 class="text-xl font-bold text-center my-6">
    メモ
  </h1>

  <!-- 検索 -->
  <%= form_with url: memos_path, method: :get, class: "mb-4" do |f| %>
    <%= f.text_field :q,
        value: params[:q],
        placeholder: "メモ検索",
        class: "input input-bordered w-full" %>
  <% end %>

  <% if @memos.any? %>

    <div class="space-y-3">

      <% @memos.each do |memo| %>

        <%= link_to memo_path(memo), class: "block" do %>

          <div class="bg-white rounded-2xl p-4 shadow-sm border border-base-200 hover:shadow-md transition">
            <p class="text-sm text-gray-700 whitespace-pre-line line-clamp-3 leading-relaxed"><%= memo.content.to_s.gsub(/\A\n+/, "") %></p>

            <!-- 日時 -->
            <p class="text-xs text-gray-400 mt-2">
  <%= l(memo.memo_date, format: "%Y/%m/%d") %>
</p>

          </div>

        <% end %>

      <% end %>

    </div>

  <% else %>

    <div class="text-center py-20 text-gray-400 text-sm">
      まだメモがありません
    </div>

  <% end %>

  <!-- 新規作成ボタン -->
  <div class="fixed bottom-20 left-0 right-0 px-4 flex justify-center">

    <%= link_to "メモを書く",
        new_memo_path,
        class: "btn btn-primary btn-lg w-full max-w-md shadow-lg font-bold" %>

  </div>

</div>