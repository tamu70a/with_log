<div class="max-w-md mx-auto mt-8 px-4">
  <h1 class="text-2xl font-bold text-center mb-6">
    設定
  </h1>

  <div class="card bg-base-100 shadow-md">
    <div class="card-body p-4 space-y-3">

      <%= link_to settings_theme_setting_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>テーマカラー設定</span>
        <span>›</span>
      <% end %>

      <%= link_to new_settings_weight_goal_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>体重目標設定</span>
        <span>›</span>
      <% end %>

      <%= link_to settings_body_records_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>体重記録管理</span>
        <span>›</span>
      <% end %>

      <%= link_to settings_growth_setting_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>成長記録表示設定</span>
        <span>›</span>
      <% end %>

      <%= link_to settings_children_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>お子さま管理</span>
        <span>›</span>
      <% end %>

      <%= link_to edit_user_registration_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>アカウント設定</span>
        <span>›</span>
      <% end %>

      <%= link_to terms_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>利用規約</span>
        <span>›</span>
      <% end %>

      <%= link_to privacy_path,
            class: "btn btn-outline w-full justify-between" do %>
        <span>プライバシーポリシー</span>
        <span>›</span>
      <% end %>

      <%= button_to destroy_user_session_path,
            method: :delete,
            class: "btn btn-error btn-outline w-full" do %>
        ログアウト
      <% end %>

    </div>
  </div>
</div>