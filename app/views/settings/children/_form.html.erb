<div class="max-w-md mx-auto px-4 space-y-8">

  <%= form_with model: [:settings, child], local: true do |f| %>

    <div class="space-y-6 bg-base-100 p-6 rounded-2xl border border-base-200 shadow-sm">

      <!-- 名前入力 -->
      <div class="form-control w-full">
        <%= f.label :name, class: "label" do %>
          <span class="label-text font-bold text-gray-600">
            お子さまのお名前
          </span>
        <% end %>

        <%= f.text_field :name,
              class: "input input-bordered w-full focus:input-primary bg-base-100",
              placeholder: "例：はなちゃん" %>
      </div>

      <!-- 生年月日入力 -->
      <div class="form-control w-full">
        <%= f.label :birthday, class: "label" do %>
          <span class="label-text font-bold text-gray-600">
            お子さまの生年月日
          </span>
        <% end %>

        <%= f.date_field :birthday,
              class: "input input-bordered w-full focus:input-primary bg-base-100" %>
      </div>

      <!-- アクションボタン群 -->
      <div class="flex flex-col gap-4 mt-8">

        <%= f.submit child.new_record? ? "登録" : "更新",
              class: "btn btn-primary w-full shadow-md" %>

        <% if child.persisted? %>
          <%= link_to "お子さまの情報を削除", settings_child_path(child),
                data: { turbo_method: :delete, turbo_confirm: "このお子さまの情報を削除します。よろしいですか？" },
                class: "btn btn-ghost btn-sm text-error underline decoration-1 underline-offset-4" %>
        <% end %>

      </div>

    </div>

  <% end %>

</div>