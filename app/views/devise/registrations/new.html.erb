<h2 class="text-2xl font-bold text-center mb-6 text-gray-800">
  <%= t('devise.registrations.new.sign_up') %>
</h2>

<div class="max-w-sm mx-auto bg-white shadow-xl rounded-xl p-8 space-y-6">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%# ニックネーム %>
    <div>
      <label class="label">
        <span class="label-text font-semibold">ニックネーム</span>
      </label>
      <%= f.text_field :nickname, autofocus: true, class: "input input-bordered w-full bg-base-200" %>
      <p class="text-[10px] text-gray-500 mt-1">※バディがこの名前であなたを呼びます</p>
    </div>

    <%# メールアドレス %>
    <div>
      <label class="label">
        <span class="label-text font-semibold"><%= t('activerecord.attributes.user.email') %></span>
      </label>
      <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full bg-base-200" %>
    </div>

    <%# パスワード %>
    <div>
      <label class="label">
        <span class="label-text font-semibold"><%= t('activerecord.attributes.user.password') %></span>
        <% if @minimum_password_length %>
          <span class="text-xs text-gray-500">（<%= @minimum_password_length %>文字以上）</span>
        <% end %>
      </label>
      <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full bg-base-200" %>
    </div>

    <%# パスワード確認 %>
    <div>
      <label class="label">
        <span class="label-text font-semibold"><%= t('activerecord.attributes.user.password_confirmation') %></span>
      </label>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full bg-base-200" %>
    </div>

    <%# 子育てメッセージON/OFF %>
    <div class="form-control bg-base-100 border border-base-300 rounded-lg p-3">
      <label class="label cursor-pointer justify-between pb-1">
        <span class="label-text font-semibold text-gray-700 text-[11px]">子育てメッセージ</span>
        <%= f.check_box :childcare_mode, class: "toggle toggle-primary toggle-sm" %>
      </label>
      <div class="px-1">
        <p class="text-[11px] leading-tight text-gray-400">
          ONにすると、バディとの会話に育児に関するメッセージが追加されます。
        </p>
      </div>
    </div>

    <%# ボタン %>
    <div class="pt-4">
      <%= f.submit t('devise.registrations.new.sign_up'), class: "btn btn-primary btn-block text-lg" %>
    </div>
  <% end %>

  <div class="text-center text-sm text-gray-600 pt-2">
    <%= link_to "ログインはこちら", new_session_path(resource_name), class: "link link-hover text-blue-600" %>
  </div>
</div>