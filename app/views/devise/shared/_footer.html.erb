<footer class="fixed bottom-0 w-full bg-pink-100 text-gray-700 shadow-inner z-50">
  <div class="grid grid-cols-6 text-center text-[10px]">
    
    <%# ホーム %>
    <%= link_to root_path, class: "flex flex-col items-center p-2 hover:text-pink-500" do %>
      <%= image_tag "home.png", alt: "home", class: "w-6 h-6 mb-1" %>
      home
    <% end %>

    <%# 習慣 %>
    <%= link_to habits_path, class: "flex flex-col items-center p-2 hover:text-pink-500" do %>
      <%= image_tag "habit.png", alt: "habit", class: "w-6 h-6 mb-1" %>
      habit
    <% end %>

    <%# メモ %>
    <%= link_to memos_path, class: "flex flex-col items-center p-2 hover:text-pink-500" do %>
      <%= image_tag "memo.png", alt: "memo", class: "w-6 h-6 mb-1" %>
      memo
    <% end %>

    <%# 体重記録 %>
    <%= link_to body_records_path, class: "flex flex-col items-center p-2 hover:text-pink-500" do %>
      <%= image_tag "weight.png", alt: "weight", class: "w-6 h-6 mb-1" %>
      weight
    <% end %>

    <%# 成長記録 %>
    <% if current_user.is_growth_record_enabled? %>
  <% if current_user.children.exists? %>
    <%= link_to child_growth_records_path(current_user.children.first), class: "flex flex-col items-center p-2 hover:text-pink-500" do %>
      <%= image_tag "growth_record.png", alt: "growth_record", class: "w-6 h-6 mb-1" %>
      growth
    <% end %>
  <% else %>
    <%# 未登録時の誘導用 %>
    <%= link_to new_settings_child_path, class: "flex flex-col items-center p-2 text-gray-400 hover:text-pink-400", title: "まずはお子様情報を登録してください" do %>
      <%= image_tag "growth_record.png", alt: "growth_record", class: "w-6 h-6 mb-1 grayscale opacity-50" %>
      <span class="text-[10px]">未登録</span>
    <% end %>
  <% end %>
<% end %>

    <%# 設定 %>
    <%= link_to settings_root_path, class: "flex flex-col items-center p-2 hover:text-pink-500" do %>
      <%= image_tag "setting.png", alt: "setting", class: "w-6 h-6 mb-1" %>
      setting
    <% end %>

  </div>
</footer>