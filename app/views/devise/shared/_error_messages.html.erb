<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class="mb-5">
    <%# DaisyUIの alert クラスを使用 %>
    <div class="alert alert-error bg-red-50 border-red-200 text-red-800 shadow-sm">
      <div class="flex flex-col items-start">
        <%# タイトル部分 %>
        <div class="flex items-center gap-2 font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span><%= I18n.t("errors.messages.not_saved",
                         count: resource.errors.count,
                         resource: resource.class.model_name.human.downcase) %></span>
        </div>
        <%# エラー内容のリスト %>
        <ul class="mt-2 ml-8 list-disc text-sm opacity-90">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>